{
  "name": "rm-onenote-web-extension",
  "version": "1.1.0",
  "private": true,
  "description": "Serverless Manifest V3 browser extension for syncing reMarkable notebooks to Microsoft OneNote.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --mode chromium",
    "dev:firefox": "vite --mode firefox",
    "build": "tsc -b && pnpm run build:chromium && pnpm run build:firefox",
    "build:chromium": "vite build --mode chromium",
    "build:firefox": "vite build --mode firefox",
    "package": "pnpm run build && node scripts/package.mjs",
    "pack": "node scripts/package.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.313",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^3.0.8"
  }
}
